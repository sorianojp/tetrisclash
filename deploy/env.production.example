# Production .env template for Tetris Clash.
# Copy to /var/www/tetrisclash/.env, fill in the blanks, then run `php artisan key:generate`.

APP_NAME="Tetris Clash"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tetrisclash.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# MySQL comes with the DigitalOcean Laravel droplet. Matchmaking and duel results use row
# locks, which MySQL enforces properly under concurrent requests.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tetrisclash
DB_USERNAME=tetrisclash
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# Ranked-match energy: the most a player can hold, and minutes to refill one point.
ENERGY_MAX=5
ENERGY_REGEN_MINUTES=20

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Players must verify their email before they can play, so real mail is required.
# Resend sends over HTTPS, so DigitalOcean's SMTP block doesn't matter. The from-address
# must be on a domain verified in the Resend dashboard.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="noreply@tetrisclash.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Reverb. Generate fresh values for production; don't reuse the local ones.
#   REVERB_APP_ID:     any number, e.g. `shuf -i 100000-999999 -n 1`
#   REVERB_APP_KEY:    `openssl rand -hex 16`
#   REVERB_APP_SECRET: `openssl rand -hex 32`
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Laravel talks to Reverb directly on the droplet...
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# ...while browsers go through nginx over HTTPS. These are baked into the JS at build time,
# so rebuild (`npm run build`) after changing them.
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=tetrisclash.example.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
